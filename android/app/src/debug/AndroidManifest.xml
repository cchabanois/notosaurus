<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (merged into the app's manifest): the lessons exported or imported from
     adb, without the settings' document picker. DUMP: a permission only the shell (adb) and
     the system hold, so no other app can send these. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugTransferReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.notosaurus.debug.EXPORT" />
                <action android:name="app.notosaurus.debug.IMPORT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
