<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The 🎤 of the instructions and the correction: asked the first time it's used -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Working: the app kept running while the AI makes a lesson, its network kept (Android 15+
         cuts a cached app's); a short service, no permission asked of the user -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- AnkiDroid: its content provider, visible to us (Android 11+) -->
    <queries>
        <package android:name="com.ichi2.anki" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Notosaurus"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic: plain http is needed for
             - "With my computer" (Computer.kt): the phone talks to the Anki add-on's Notosaurus
               on the family's computer, over the home Wi-Fi, at whatever LAN address its QR code
               gives (192.168.x.y…). That server has no certificate a phone could trust; it
               answers a phone only paired with the QR code's token. A network security config
               can't help: it lists hosts, not address ranges, and the computer's address is
               only known at pairing.
             - the WebView's own server (LocalServer.kt), on 127.0.0.1: never leaves the phone.
             Everything that goes to the relay (lessons, photos, licence) is https: the built-in
             addresses (build.gradle.kts) and those RelayDirectory follows (https only); only one
             typed by hand in the settings, "Advanced", could be http. -->

        <!-- Turned, resized (a fold, a split screen): the page stays as it is, with the lesson
             being made (recreated, it was loaded again: photos and prompt lost) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "✎ Notosaurus" on a card in AnkiDroid (the note types' link, app/note_types/common.py):
                 the documentation's /fix/ page, then notosaurus://fix?lesson=…&key=… from its button;
                 the https link itself when Android lets the app take it (its settings, or a verified
                 assetlinks.json at the site's root one day) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="notosaurus" android:host="fix" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="cchabanois.github.io" android:pathPrefix="/notosaurus/fix" />
            </intent-filter>
        </activity>

        <service
            android:name=".WorkingService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- The camera writes its photos here; AnkiDroid reads the cards' sound from here -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>
        <!-- The lessons exported or imported from adb (AdbTransferReceiver). DUMP: a permission only
         the shell (adb) and the system hold, so no other app can send these. -->
        <receiver
            android:name=".AdbTransferReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.notosaurus.adb.EXPORT" />
                <action android:name="app.notosaurus.adb.IMPORT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
